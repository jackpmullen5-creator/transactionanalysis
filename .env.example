# Copy to .env and adjust. Run `npm run setup` after creating this file.

# SQLite database location
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. Use a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-16-chars"

# Seed admin credentials (created by `npm run db:seed`)
ADMIN_EMAIL="jackpmullen5@gmail.com"
ADMIN_PASSWORD="admin1234"
ADMIN_NAME="Jack Mullen"
