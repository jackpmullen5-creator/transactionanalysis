# Copy to .env for local dev. On Vercel, set these in Project Settings → Environment Variables.

# Postgres connection string. For Neon, use the connection string from your
# project dashboard (include ?sslmode=require). Example:
# postgresql://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign session JWTs. Use a long random string (>=16 chars).
# Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-at-least-16-chars"

# Anthropic API key — required for reading/analyzing uploaded PDFs.
# Get one at https://console.anthropic.com/ . Without it, PDF upload is disabled.
ANTHROPIC_API_KEY="sk-ant-..."

# Seed admin credentials (created automatically on deploy by the build step).
ADMIN_EMAIL="jackpmullen5@gmail.com"
ADMIN_PASSWORD="admin1234"
ADMIN_NAME="Jack Mullen"
